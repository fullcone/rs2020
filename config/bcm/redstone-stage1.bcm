# Redstone stage-1 BCM56846 bring-up map.
#
# This file is intentionally limited to front-panel port-to-SerDes mapping.
# switchd currently consumes only portmap_* keys; the later Broadcom SDK path
# must add PHY polarity, external PHY address, MDI pair, MMU, L2/L3, and ACL
# programming separately.
#
# To use in a Redstone image:
#   cp /etc/switchd/redstone-stage1.bcm /etc/switchd/config.bcm
#   systemctl restart switchd

portmap_1=6:10
portmap_2=5:10
portmap_3=8:10
portmap_4=7:10
portmap_5=10:10
portmap_6=9:10
portmap_7=12:10
portmap_8=11:10
