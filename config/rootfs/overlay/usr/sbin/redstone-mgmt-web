#!/bin/sh
# Start the optional Redstone read-only management web UI.

set -eu

BIND=${REDSTONE_MGMT_BIND:-0.0.0.0:8080}
DOCROOT=${REDSTONE_MGMT_DOCROOT:-/www}
FALLBACK_HTTPD=${REDSTONE_MGMT_HTTPD:-/usr/sbin/redstone-httpd/httpd}

busybox_has_httpd() {
    "$1" --list 2>/dev/null | grep -qx httpd
}

httpd_help_looks_usable() {
    output=$("$@" --help 2>&1 || true)
    printf '%s\n' "$output" | grep -q httpd &&
        printf '%s\n' "$output" | grep -q -- '-p' &&
        printf '%s\n' "$output" | grep -q -- '-h' &&
        printf '%s\n' "$output" | grep -Eq -- '(^|[[:space:]])-f|\[-[^]]*f'
}

busybox_httpd_usable() {
    busybox_has_httpd "$1" && httpd_help_looks_usable "$1" httpd
}

if [ ! -d "$DOCROOT/redstone" ]; then
    echo "redstone-mgmt-web: missing web assets under $DOCROOT/redstone" >&2
    exit 1
fi

if httpd_path=$(command -v httpd 2>/dev/null) && httpd_help_looks_usable "$httpd_path"; then
    exec "$httpd_path" -f -p "$BIND" -h "$DOCROOT"
fi

if busybox_path=$(command -v busybox 2>/dev/null) && busybox_httpd_usable "$busybox_path"; then
    exec "$busybox_path" httpd -f -p "$BIND" -h "$DOCROOT"
fi

if [ -x "$FALLBACK_HTTPD" ] && httpd_help_looks_usable "$FALLBACK_HTTPD"; then
    exec "$FALLBACK_HTTPD" -f -p "$BIND" -h "$DOCROOT"
fi

echo "redstone-mgmt-web: BusyBox httpd is unavailable" >&2
exit 1
