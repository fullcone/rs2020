#!/bin/bash
# switchd-init - Start/stop EdgeNOS switch daemon
#
# Boot sequence (from Cumulus RE):
#   platform-init.sh -> switchd-init start -> networking
#
# switchd internally does:
#   1. BDE open -> CDK probe -> BMD reset -> BMD init (Warpcore firmware)
#   2. BMD switching init (L2 table, VLAN 1)
#   3. Port mode set (10G/40G) + TX driver config (idriver=2, predriver=3)
#   4. Create 52 TUN interfaces -> netlink listener -> main loop

set -e
log() { logger -t switchd-init "$*"; echo "switchd-init: $*"; }

SWITCHD=/usr/sbin/switchd
PIDFILE=/var/run/switchd.pid
LOGFILE=/var/log/switchd.log
CPLD="/sys/devices/ff705000.localbus/ea000000.cpld"
DEFAULT_BOARD="as5610-52x"
BOARD_FILE="/etc/edgenos/board"
DEFAULT_CONFIG="/etc/switchd/config.bcm"
REDSTONE_CONFIG="/etc/switchd/redstone-stage1.bcm"

detect_board() {
    if [ -n "${EDGENOS_BOARD:-}" ]; then
        echo "$EDGENOS_BOARD"
        return
    fi

    if [ -r "$BOARD_FILE" ]; then
        sed -n '1{s/[[:space:]]//g;p;q}' "$BOARD_FILE"
        return
    fi

    echo "$DEFAULT_BOARD"
}

select_config() {
    board="$(detect_board)"
    [ -n "$board" ] || board="$DEFAULT_BOARD"
    board_lc="$(echo "$board" | tr '[:upper:]' '[:lower:]')"

    case "$board_lc" in
    redstone|rs2020|r0678)
        config="$REDSTONE_CONFIG"
        ;;
    *)
        config="$DEFAULT_CONFIG"
        ;;
    esac

    mkdir -p /etc/switchd

    if [ ! -f "$config" ]; then
        if [ "$config" != "$DEFAULT_CONFIG" ] && [ -f "$DEFAULT_CONFIG" ]; then
            log "WARNING: $config missing for board=$board, falling back to $DEFAULT_CONFIG"
            config="$DEFAULT_CONFIG"
        elif [ "$config" = "$DEFAULT_CONFIG" ]; then
            log "WARNING: $DEFAULT_CONFIG missing, creating empty default config"
            touch "$DEFAULT_CONFIG"
        else
            log "FATAL: no switchd config for board=$board ($config missing)"
            exit 1
        fi
    fi

    SELECTED_BOARD="$board"
    SELECTED_CONFIG="$config"
}

preflight() {
    # Check BDE modules
    if [ ! -c /dev/linux-kernel-bde ]; then
        log "BDE not loaded, running platform-init..."
        /usr/sbin/platform-init.sh
    fi

    # Wait for BDE device
    for i in $(seq 1 10); do
        [ -c /dev/linux-kernel-bde ] && break
        sleep 1
    done
    [ -c /dev/linux-kernel-bde ] || { log "FATAL: BDE device not found"; exit 1; }

    # Check ASIC on PCIe
    if lspci 2>/dev/null | grep -qi "broadcom"; then
        log "BCM56846 found on PCIe"
    else
        log "WARNING: BCM56846 not detected via lspci"
    fi

    select_config
    log "Using board=${SELECTED_BOARD}, config=${SELECTED_CONFIG}"
}

case "$1" in
start)
    log "Starting EdgeNOS switchd..."

    preflight

    # Start switchd in foreground mode, log to a file, and keep its real PID.
    mkdir -p "$(dirname "$LOGFILE")"
    "$SWITCHD" -f -c "$SELECTED_CONFIG" >> "$LOGFILE" 2>&1 &
    echo $! > $PIDFILE
    log "switchd pid $(cat $PIDFILE), logging to $LOGFILE"

    # Wait for ports to come up
    sleep 8
    port_count=$(ip link show 2>/dev/null | grep -c "swp" || true)
    log "switchd started, $port_count ports created"

    # Set system LED to green
    [ -f "${CPLD}/led_diag" ] && echo green > "${CPLD}/led_diag" 2>/dev/null
    ;;

start-foreground)
    log "Starting EdgeNOS switchd in foreground..."
    preflight
    mkdir -p "$(dirname "$PIDFILE")"
    echo $$ > "$PIDFILE"
    exec "$SWITCHD" -f -c "$SELECTED_CONFIG"
    ;;

stop)
    log "Stopping switchd..."
    [ -f $PIDFILE ] && kill $(cat $PIDFILE) 2>/dev/null
    rm -f $PIDFILE

    # Set system LED to yellow
    [ -f "${CPLD}/led_diag" ] && echo yellow > "${CPLD}/led_diag" 2>/dev/null
    ;;

restart)
    $0 stop; sleep 2; $0 start
    ;;

status)
    if [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null; then
        echo "switchd is running (PID $(cat $PIDFILE))"
        ip link show 2>/dev/null | grep -c "swp" | xargs echo "Ports:"
    else
        echo "switchd is not running"
    fi
    ;;

*)
    echo "Usage: $0 {start|start-foreground|stop|restart|status}"
    exit 1
    ;;
esac
