#!/bin/sh
# Capture Redstone stage-1 bring-up evidence without changing hardware state.

set -u

ORIGINAL_ARGS="$*"
SCAN_I2C=0
VERBOSE=${REDSTONE_CAPTURE_VERBOSE:-0}
BASE_DIR=${REDSTONE_CAPTURE_DIR:-/var/log/redstone-stage1}
BASE_DIR_EXPLICIT=0
[ -n "${REDSTONE_CAPTURE_DIR+x}" ] && BASE_DIR_EXPLICIT=1

usage() {
    echo "Usage: redstone-stage1-capture [--scan-i2c] [--verbose]"
    echo "  --scan-i2c  additionally run active i2cdetect scans on discovered buses"
    echo "  --verbose   echo capture progress to the console"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --scan-i2c)
            SCAN_I2C=1
            shift
            ;;
        --verbose)
            VERBOSE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

if ! mkdir -p "$BASE_DIR" 2>/dev/null; then
    if [ "$BASE_DIR_EXPLICIT" = "1" ]; then
        echo "redstone-stage1-capture: cannot create REDSTONE_CAPTURE_DIR: $BASE_DIR" >&2
        exit 1
    fi
    BASE_DIR=/tmp/redstone-stage1
    mkdir -p "$BASE_DIR" || exit 1
fi

STAMP=$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null || date +%s)
OUT_DIR="$BASE_DIR/$STAMP"
LOG="$OUT_DIR/capture.log"

mkdir -p "$OUT_DIR" || exit 1
: > "$LOG"

log() {
    printf '%s\n' "$*" >> "$LOG"
    if [ "$VERBOSE" = "1" ]; then
        printf '%s\n' "$*"
    fi
}

capture_shell() {
    name=$1
    shift
    cmd=$1
    out="$OUT_DIR/$name.txt"

    log "capture: $name"
    {
        printf '$ %s\n\n' "$cmd"
        sh -c "$cmd"
        rc=$?
        printf '\nexit=%s\n' "$rc"
    } > "$out" 2>&1
}

copy_file() {
    src=$1
    dst=$2

    if [ -e "$src" ]; then
        log "copy: $src"
        cp -a "$src" "$OUT_DIR/$dst" >> "$LOG" 2>&1 || true
    fi
}

capture_dt_prop() {
    prop=$1
    src="/proc/device-tree/$prop"
    dst="$OUT_DIR/device-tree/$prop.txt"

    if [ -e "$src" ]; then
        mkdir -p "$(dirname "$dst")"
        tr '\000' '\n' < "$src" > "$dst" 2>>"$LOG" || true
    fi
}

capture_tree_listing() {
    src=$1
    name=$2
    maxdepth=${3:-3}
    out="$OUT_DIR/$name.txt"

    [ -e "$src" ] || return 0

    log "listing: $src"
    {
        printf '# %s\n' "$src"
        if find -L "$src" -maxdepth 0 >/dev/null 2>&1; then
            find -L "$src" -maxdepth "$maxdepth" 2>/dev/null
        else
            find "$src" -maxdepth "$maxdepth" 2>/dev/null
        fi | sort | while IFS= read -r path; do
            ls -ld "$path" 2>/dev/null || true
        done
    } > "$out" 2>&1
}

capture_sysfs_files() {
    src=$1
    name=$2
    maxdepth=${3:-2}

    [ -d "$src" ] || return 0

    log "sysfs: $src"
    mkdir -p "$OUT_DIR/$name"
    if find -L "$src" -maxdepth 0 -type d >/dev/null 2>&1; then
        find -L "$src" -maxdepth "$maxdepth" -type f 2>/dev/null
    else
        find "$src" -maxdepth "$maxdepth" -type f 2>/dev/null
    fi | sort | while IFS= read -r file; do
        rel=${file#"$src"/}
        safe=$(printf '%s' "$rel" | tr '/ ' '__')
        {
            printf '# %s\n' "$file"
            dd if="$file" bs=4096 count=1 2>/dev/null | tr '\000' '\n'
        } > "$OUT_DIR/$name/$safe.txt" 2>>"$LOG" || true
    done
}

write_metadata() {
    log "capture: run_metadata"
    {
        printf 'stamp=%s\n' "$STAMP"
        printf 'utc=%s\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -u 2>/dev/null || true)"
        printf 'local_time=%s\n' "$(date 2>/dev/null || true)"
        printf 'hostname=%s\n' "$(hostname 2>/dev/null || true)"
        printf 'pwd=%s\n' "$(pwd 2>/dev/null || true)"
        printf 'args=%s\n' "$ORIGINAL_ARGS"
        printf 'scan_i2c=%s\n' "$SCAN_I2C"
        printf 'verbose=%s\n' "$VERBOSE"
        printf 'base_dir=%s\n' "$BASE_DIR"
        printf 'out_dir=%s\n' "$OUT_DIR"
        printf 'uid_info=%s\n' "$(id 2>/dev/null || true)"
    } > "$OUT_DIR/run_metadata.txt" 2>>"$LOG" || true
}

write_summary() {
    summary="$OUT_DIR/capture-summary.txt"

    log "capture: capture-summary"
    {
        echo "Redstone stage-1 capture summary"
        echo "out_dir=$OUT_DIR"
        echo "stamp=$STAMP"
        if [ -f "$OUT_DIR/etc_edgenos_board.txt" ]; then
            printf 'board='
            tr -d '\r\n' < "$OUT_DIR/etc_edgenos_board.txt"
            echo
        else
            echo "board=missing"
        fi
        if [ -f "$OUT_DIR/device-tree/model.txt" ]; then
            printf 'dt_model='
            tr '\n' ' ' < "$OUT_DIR/device-tree/model.txt" | sed 's/[[:space:]]*$//'
            echo
        fi
        if [ -f "$OUT_DIR/device-tree/compatible.txt" ]; then
            printf 'dt_compatible='
            tr '\n' ' ' < "$OUT_DIR/device-tree/compatible.txt" | sed 's/[[:space:]]*$//'
            echo
        fi
        if grep -Eiq '(^|[^[:xdigit:]])14e4:b846([^[:xdigit:]]|$)|vendor=0x14e4[[:space:]]+device=0xb846' \
            "$OUT_DIR/pci.txt" "$OUT_DIR/pci_driver_details.txt" "$OUT_DIR/dmesg_redstone_focus.txt" 2>/dev/null; then
            echo "bcm56846_pci=yes"
        else
            echo "bcm56846_pci=no"
        fi
        echo "swp_links:"
        for d in /sys/class/net/swp*; do
            [ -d "$d" ] || continue
            iface=${d##*/}
            carrier=unknown
            operstate=unknown
            speed=unknown
            [ -r "$d/carrier" ] && carrier=$(cat "$d/carrier" 2>/dev/null || echo unknown)
            [ -r "$d/operstate" ] && operstate=$(cat "$d/operstate" 2>/dev/null || echo unknown)
            [ -r "$d/speed" ] && speed=$(cat "$d/speed" 2>/dev/null || echo unknown)
            printf '  %s carrier=%s operstate=%s speed=%s\n' "$iface" "$carrier" "$operstate" "$speed"
        done
        echo "bde_dev_nodes:"
        for d in /dev/*bde* /dev/*bcm* /dev/*uk*; do
            [ -e "$d" ] || continue
            ls -l "$d" 2>/dev/null || true
        done
        echo "top_level_files:"
        ls -1 "$OUT_DIR" 2>/dev/null | sed 's/^/  /'
    } > "$summary" 2>>"$LOG" || true
}

write_metadata
copy_file /etc/edgenos/board etc_edgenos_board.txt
copy_file /etc/os-release etc_os-release.txt
copy_file /etc/inittab etc_inittab.txt
copy_file /etc/fstab etc_fstab.txt

mkdir -p "$OUT_DIR/device-tree"
capture_dt_prop model
capture_dt_prop compatible
capture_dt_prop '#address-cells'
capture_dt_prop '#size-cells'
capture_dt_prop aliases/ethernet0
capture_dt_prop aliases/ethernet1
capture_dt_prop aliases/ethernet2
capture_dt_prop aliases/serial0
capture_dt_prop aliases/pci0
capture_dt_prop aliases/pci1

capture_shell uname 'uname -a'
capture_shell command_inventory 'for c in sh uname dmesg lspci lsmod modinfo insmod rmmod ip ifconfig ethtool phytool mii-diag mdio devmem tc ss ping i2cdetect i2cdump i2cget journalctl systemctl switchd switchd-init redstone-mgmt-status redstone-mgmt-web redstone-openbcm-init-probe redstone-stage1-validate redstone-stage1-bench-run tar gzip awk sed grep find readlink stat httpd; do printf "%s=" "$c"; command -v "$c" 2>/dev/null || echo unavailable; done'
capture_shell redstone_mgmt_status 'if command -v redstone-mgmt-status >/dev/null 2>&1; then redstone-mgmt-status; else echo "redstone-mgmt-status unavailable"; fi'
capture_shell cmdline 'cat /proc/cmdline'
capture_shell cpuinfo 'cat /proc/cpuinfo'
capture_shell memory 'cat /proc/meminfo'
capture_shell mounts 'cat /proc/mounts; echo; df -h 2>/dev/null || true'
capture_shell proc_interrupts 'cat /proc/interrupts 2>/dev/null || true'
capture_shell proc_iomem_ioports 'cat /proc/iomem 2>/dev/null || true; echo; cat /proc/ioports 2>/dev/null || true'
capture_shell kernel_config 'if [ -r /proc/config.gz ]; then gzip -dc /proc/config.gz 2>/dev/null || zcat /proc/config.gz 2>/dev/null || true; else echo "/proc/config.gz unavailable"; fi'
capture_shell modules 'cat /proc/modules 2>/dev/null || true; echo; lsmod 2>/dev/null || true'
capture_shell modinfo_bringup 'if command -v modinfo >/dev/null 2>&1; then for m in linux-kernel-bde linux-user-bde bcm56846 bcm-knet ds100df410 retimer_class accton_as5610_52x_cpld i2c-mpc i2c-mux-pca954x gianfar; do echo "## $m"; modinfo "$m" 2>&1 || modinfo "/lib/modules/extra/$m.ko" 2>&1 || true; done; else echo "modinfo unavailable"; fi'
capture_shell dmesg 'dmesg'
capture_shell dmesg_redstone_focus 'dmesg | grep -iE "openbcm|bcm|bde|trident|5684|gianfar|i2c|cpld|sfp|qsfp|retimer|pcie|pci|dma|eth|eeprom|switchd|swp|mdio|phy|serdes" || true'
capture_shell pci 'if command -v lspci >/dev/null 2>&1; then lspci -nn -vv; else echo "lspci unavailable"; fi; echo; for d in /sys/bus/pci/devices/*; do [ -d "$d" ] || continue; echo "## $d"; for f in vendor device class subsystem_vendor subsystem_device irq local_cpus numa_node dma_mask_bits consistent_dma_mask_bits enable modalias; do [ -r "$d/$f" ] && printf "%s=" "$f" && cat "$d/$f"; done; done'
capture_shell pci_driver_details 'for d in /sys/bus/pci/devices/*; do [ -d "$d" ] || continue; slot=${d##*/}; echo "## $slot"; for f in vendor device class subsystem_vendor subsystem_device irq local_cpus numa_node dma_mask_bits consistent_dma_mask_bits enable modalias; do [ -r "$d/$f" ] && printf "%s=" "$f" && cat "$d/$f"; done; if [ -L "$d/driver" ]; then printf "driver="; basename "$(readlink "$d/driver")"; fi; if [ -r "$d/resource" ]; then echo "resource:"; cat "$d/resource"; fi; if command -v lspci >/dev/null 2>&1; then echo "lspci -s $slot -nn -vv -xxx:"; lspci -s "$slot" -nn -vv -xxx 2>&1 || true; fi; echo; done'
capture_shell net 'ip addr 2>/dev/null || ifconfig -a 2>/dev/null || true; echo; ip link 2>/dev/null || true; echo; for d in /sys/class/net/*; do [ -d "$d" ] || continue; iface=${d##*/}; echo "## $iface"; for f in address operstate carrier carrier_changes speed duplex mtu ifindex iflink type tx_queue_len dev_id dev_port addr_assign_type dormant proto_down; do [ -r "$d/$f" ] && printf "%s=" "$f" && cat "$d/$f"; done; if command -v ethtool >/dev/null 2>&1; then ethtool "$iface" 2>/dev/null || true; ethtool -i "$iface" 2>/dev/null || true; fi; done'
capture_shell net_counters 'if command -v ip >/dev/null 2>&1; then ip -s -d link; echo; ip -4 route show table all 2>/dev/null || true; echo; ip -6 route show table all 2>/dev/null || true; echo; ip neigh show 2>/dev/null || true; fi; echo; if command -v ss >/dev/null 2>&1; then ss -tunap 2>/dev/null || true; fi; echo; for d in /sys/class/net/*; do [ -d "$d" ] || continue; iface=${d##*/}; echo "## $iface"; if [ -d "$d/statistics" ]; then for f in "$d"/statistics/*; do [ -r "$f" ] && printf "%s=" "${f##*/}" && cat "$f"; done; fi; if command -v ethtool >/dev/null 2>&1; then ethtool -S "$iface" 2>/dev/null || true; ethtool -k "$iface" 2>/dev/null || true; ethtool -a "$iface" 2>/dev/null || true; ethtool -g "$iface" 2>/dev/null || true; ethtool -c "$iface" 2>/dev/null || true; fi; if command -v tc >/dev/null 2>&1; then tc -s qdisc show dev "$iface" 2>/dev/null || true; fi; echo; done'
capture_shell mdio_phytool 'if command -v phytool >/dev/null 2>&1; then for spec in eth1/3 eth1/11 eth0/3 eth2/12; do echo "## phytool print $spec"; phytool print "$spec" 2>&1 || true; for reg in 0 1 2 3 4 5 9 10 16 17 18 24 25 26 27 28 29 30 31; do printf "%s/%s=" "$spec" "$reg"; phytool read "$spec/$reg" 2>&1 || true; done; echo; done; else echo "phytool unavailable"; fi'
capture_shell gianfar_registers 'if command -v devmem >/dev/null 2>&1; then for base in 0xffe24000 0xffe25000 0xffe26000; do echo "## $base"; for off in 0x000 0x004 0x010 0x014 0x020 0x02c 0x030 0x100 0x104 0x114 0x300 0x304 0x314 0x500 0x504 0x510 0x538 0x53c 0x540 0x544 0x680 0x684 0x688 0x68c 0x690 0x694 0x698 0x69c 0x6a0 0x6a4 0x6a8 0x6ac 0x6b0 0x6b4 0x6b8 0x6bc 0x6c0 0x6c4 0x6c8 0x6cc 0x6d0 0x6d4 0x6d8 0x6dc 0x6e0 0x6e4 0x6e8 0x6ec 0x6f0 0x6f4 0x6f8 0x6fc 0x700 0x704 0x708 0x70c 0x710 0x714 0x718 0x71c 0x720 0x724 0x728 0x72c 0x730 0x734 0x738 0x73c 0x740; do addr=$(printf "0x%x" $((base + off))); printf "%s+%s %s=" "$base" "$off" "$addr"; devmem "$addr" 32 2>&1 || true; done; echo; done; else echo "devmem unavailable"; fi'
capture_shell i2c_list 'if command -v i2cdetect >/dev/null 2>&1; then i2cdetect -l; else echo "i2cdetect unavailable"; fi; echo; ls -la /sys/bus/i2c/devices 2>/dev/null || true'
capture_shell i2c_devices 'for d in /sys/bus/i2c/devices/*; do [ -e "$d" ] || continue; echo "## $d"; for f in name modalias uevent; do [ -r "$d/$f" ] && echo "-- $f" && cat "$d/$f"; done; if [ -L "$d/driver" ]; then printf "driver="; basename "$(readlink "$d/driver")"; fi; if [ -e "$d/of_node/compatible" ]; then printf "of_compatible="; tr "\000" " " < "$d/of_node/compatible"; echo; fi; if [ -e "$d/of_node/name" ]; then printf "of_name="; tr "\000" " " < "$d/of_node/name"; echo; fi; echo; done'
capture_shell switchd 'switchd-init status 2>/dev/null || true; echo; if command -v systemctl >/dev/null 2>&1; then systemctl status switchd --no-pager 2>&1 || true; systemctl --failed --no-pager 2>&1 || true; fi; echo; if command -v journalctl >/dev/null 2>&1; then journalctl -u switchd -b --no-pager 2>&1 || true; fi; echo; ps w 2>/dev/null || ps 2>/dev/null || true; echo; pids=$(pidof switchd 2>/dev/null || true); for p in $pids; do echo "## /proc/$p"; cat "/proc/$p/status" 2>/dev/null || true; tr "\000" " " < "/proc/$p/cmdline" 2>/dev/null || true; echo; cat "/proc/$p/limits" 2>/dev/null || true; ls -la "/proc/$p/fd" 2>/dev/null || true; done; echo; ls -la /etc/switchd 2>/dev/null || true; echo; ls -la /run 2>/dev/null | grep -i switchd || true; ls -la /var/run 2>/dev/null | grep -i switchd || true; echo; for f in /etc/switchd/*.bcm /etc/switchd/config.bcm; do [ -f "$f" ] || continue; echo "## $f"; sed -n "1,260p" "$f"; done'
capture_shell bde_devices 'ls -l /dev 2>/dev/null | grep -iE "bde|bcm|uk|proxy" || true; echo; for d in /dev/*bde* /dev/*bcm* /dev/*uk* /dev/*proxy*; do [ -e "$d" ] || continue; echo "## $d"; ls -l "$d" 2>/dev/null || true; stat "$d" 2>/dev/null || true; done; echo; for p in /proc/linux* /proc/bcm* /proc/driver/*bde* /proc/driver/*bcm* /proc/driver/linux*; do [ -e "$p" ] || continue; echo "## $p"; if [ -d "$p" ]; then ls -la "$p" 2>/dev/null || true; elif [ -r "$p" ]; then sed -n "1,220p" "$p" 2>/dev/null || cat "$p" 2>/dev/null || true; fi; done'
capture_shell openbcm_init_probe 'if command -v redstone-openbcm-init-probe >/dev/null 2>&1; then redstone-openbcm-init-probe --dry-run; else echo "redstone-openbcm-init-probe unavailable"; fi; echo; if [ -f /usr/share/edgenos/openbcm/redstone-openbcm-init-probe.manifest ]; then cat /usr/share/edgenos/openbcm/redstone-openbcm-init-probe.manifest; else echo "redstone-openbcm-init-probe manifest unavailable"; fi'
capture_shell services 'if command -v systemctl >/dev/null 2>&1; then systemctl --no-pager --type=service --state=running 2>&1 || true; echo; systemctl --no-pager --all 2>&1 || true; fi; echo; if [ -d /etc/init.d ]; then ls -la /etc/init.d; for f in /etc/init.d/S* /etc/init.d/*edgenos*; do [ -f "$f" ] || continue; echo "## $f"; sed -n "1,220p" "$f"; done; fi'
capture_shell devices 'ls -la /dev 2>/dev/null || true; echo; find /dev -maxdepth 2 2>/dev/null | sort | while IFS= read -r p; do ls -ld "$p" 2>/dev/null || true; done'
capture_shell logs 'if command -v journalctl >/dev/null 2>&1; then journalctl -b --no-pager; fi; for f in /var/log/messages /var/log/syslog /var/log/dmesg /var/log/kern.log; do [ -f "$f" ] || continue; echo "## $f"; cat "$f"; done'

capture_tree_listing /proc/device-tree proc_device_tree_listing 4
capture_tree_listing /sys/bus/pci/devices sys_bus_pci_devices_listing 3
capture_tree_listing /sys/bus/i2c/devices sys_bus_i2c_devices_listing 3
capture_tree_listing /sys/class/net sys_class_net_listing 4
capture_tree_listing /sys/module sys_module_listing 2

capture_sysfs_files /proc/device-tree proc_device_tree 4
capture_sysfs_files /sys/class/eeprom sys_class_eeprom 2
capture_sysfs_files /sys/class/kennisis_cpld sys_class_kennisis_cpld 2
capture_sysfs_files /sys/class/cpld sys_class_cpld 2
capture_sysfs_files /sys/class/hwmon sys_class_hwmon 3
capture_sysfs_files /sys/class/thermal sys_class_thermal 3
capture_sysfs_files /sys/class/leds sys_class_leds 3
capture_sysfs_files /sys/class/gpio sys_class_gpio 3
capture_sysfs_files /sys/class/rtc sys_class_rtc 2
capture_sysfs_files /sys/class/watchdog sys_class_watchdog 2
capture_sysfs_files /sys/class/power_supply sys_class_power_supply 3
capture_sysfs_files /sys/bus/platform/devices sys_bus_platform_devices 2
capture_sysfs_files /sys/bus/of_platform/devices sys_bus_of_platform_devices 2

if [ "$SCAN_I2C" = "1" ]; then
    capture_shell i2c_scan 'if command -v i2cdetect >/dev/null 2>&1; then for b in /sys/bus/i2c/devices/i2c-*; do [ -d "$b" ] || continue; bus=${b##*-}; echo "## i2c-$bus"; i2cdetect -y "$bus" 2>&1 || true; done; else echo "i2cdetect unavailable"; fi'
else
    printf '%s\n' 'active i2cdetect scans skipped; rerun with --scan-i2c on a bench system if needed' > "$OUT_DIR/i2c_scan_skipped.txt"
fi

write_summary

if command -v tar >/dev/null 2>&1; then
    tarball="$BASE_DIR/$STAMP.tar.gz"
    if (cd "$BASE_DIR" && tar czf "$tarball" "$STAMP") >> "$LOG" 2>&1; then
        log "tarball: $tarball"
        printf 'Redstone stage-1 capture written to %s\n' "$tarball"
        exit 0
    fi
fi

printf 'Redstone stage-1 capture written to %s\n' "$OUT_DIR"
