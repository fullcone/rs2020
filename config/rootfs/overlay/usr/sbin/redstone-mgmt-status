#!/bin/sh
# Emit a read-only JSON status snapshot for Redstone stage-1 management.

set -u

BOARD_FILE=${REDSTONE_BOARD_FILE:-/etc/edgenos/board}
SWITCHD_CONFIG_DIR=${REDSTONE_SWITCHD_CONFIG_DIR:-/etc/switchd}
SDK_REF_MANIFEST=${REDSTONE_SDK_REF_MANIFEST:-"$SWITCHD_CONFIG_DIR/redstone-original-active-sdk.manifest"}
CAPTURE_BASE=${REDSTONE_CAPTURE_DIR:-/var/log/redstone-stage1}
VALIDATE_BASE=${REDSTONE_VALIDATE_DIR:-/var/log/redstone-stage1}
BENCH_BASE=${REDSTONE_BENCH_DIR:-/var/log/redstone-stage1}
ACTION_BASE=${REDSTONE_WEB_ACTION_DIR:-/var/log/redstone-stage1/web-actions}

read_first() {
    file=$1
    value=
    if [ -r "$file" ]; then
        IFS= read -r value < "$file" || true
    fi
    printf '%s' "$value"
}

json_escape() {
    printf '%s' "$1" | tr '\r\n' '  ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_str() {
    printf '"%s"' "$(json_escape "$1")"
}

bool_file() {
    if [ -e "$1" ]; then
        printf true
    else
        printf false
    fi
}

bool_cmd() {
    if command -v "$1" >/dev/null 2>&1; then
        printf true
    else
        printf false
    fi
}

bool_httpd() {
    if command -v httpd >/dev/null 2>&1; then
        printf true
    elif command -v busybox >/dev/null 2>&1 && busybox httpd --help >/dev/null 2>&1; then
        printf true
    else
        printf false
    fi
}

module_loaded() {
    name_a=$1
    name_b=$2
    if [ -r /proc/modules ] && grep -Eq "^($name_a|$name_b)[[:space:]]" /proc/modules; then
        printf true
    else
        printf false
    fi
}

sha256_file() {
    file=$1
    if [ ! -f "$file" ]; then
        printf ''
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$file" 2>/dev/null | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$file" 2>/dev/null | awk '{print $1}'
    else
        printf ''
    fi
}

latest_dir() {
    base=$1
    pattern=$2
    if [ -d "$base" ]; then
        for entry in $(ls -1dt "$base"/$pattern 2>/dev/null); do
            if [ -d "$entry" ]; then
                printf '%s' "$entry"
                return 0
            fi
        done
    fi
}

latest_file() {
    base=$1
    pattern=$2
    if [ -d "$base" ]; then
        for entry in $(ls -1dt "$base"/$pattern 2>/dev/null); do
            if [ -f "$entry" ]; then
                printf '%s' "$entry"
                return 0
            fi
        done
    fi
}

manifest_value() {
    key=$1
    file=$2
    if [ -r "$file" ]; then
        sed -n "s/^$key=//p" "$file" | head -n 1
    fi
}

grep_count() {
    file=$1
    pattern=$2
    if [ -r "$file" ]; then
        value=$(grep -Ec "$pattern" "$file" 2>/dev/null || true)
        printf '%s' "${value:-0}"
    else
        printf '0'
    fi
}

sed_last_value() {
    file=$1
    expr=$2
    if [ -r "$file" ]; then
        sed -n "$expr" "$file" 2>/dev/null | tail -n 1
    fi
}

kv_last_value() {
    file=$1
    key=$2
    if [ -r "$file" ]; then
        sed -n "s/^$key=//p" "$file" 2>/dev/null | tail -n 1
    fi
}

first_existing_file() {
    for file in "$@"; do
        if [ -f "$file" ]; then
            printf '%s' "$file"
            return 0
        fi
    done
}

board=$(read_first "$BOARD_FILE")
[ -n "$board" ] || board=unknown

if [ -n "${REDSTONE_MGMT_CONFIG:-}" ]; then
    selected_config=$REDSTONE_MGMT_CONFIG
else
    case "$board" in
        redstone|rs2020|r0678)
            selected_config="$SWITCHD_CONFIG_DIR/redstone-stage1.bcm"
            ;;
        *)
            selected_config="$SWITCHD_CONFIG_DIR/config.bcm"
            ;;
    esac
fi

config_exists=false
config_sha256=
portmap_count=0
split_mode=missing
if [ -f "$selected_config" ]; then
    config_exists=true
    config_sha256=$(sha256_file "$selected_config")
    portmap_count=$(grep -Ec '^[[:space:]]*portmap_[0-9]+([.]0)?[[:space:]]*=' "$selected_config" 2>/dev/null || true)
    [ -n "$portmap_count" ] || portmap_count=0
    if grep -Eq '^[[:space:]]*portmap_49([.]0)?[[:space:]]*=[[:space:]]*61:10[[:space:]]*$' "$selected_config" 2>/dev/null && \
        grep -Eq '^[[:space:]]*portmap_61([.]0)?[[:space:]]*=[[:space:]]*65:40[[:space:]]*$' "$selected_config" 2>/dev/null; then
        split_mode=original-active-split-49-50-51
    elif grep -Eq '^[[:space:]]*portmap_49([.]0)?[[:space:]]*=[[:space:]]*61:40[[:space:]]*$' "$selected_config" 2>/dev/null; then
        split_mode=stage1-skeleton-4x40g
    else
        split_mode=custom-or-unknown
    fi
fi

sdk_ref_exists=false
sdk_ref_sha256=
sdk_ref_schema=
sdk_ref_split=
sdk_ref_portmaps=
sdk_ref_config_sha=
sdk_ref_phy_sha=
sdk_ref_fixup_sha=
sdk_ref_globals=
sdk_ref_phy84848=
sdk_ref_unsplit=
if [ -f "$SDK_REF_MANIFEST" ]; then
    sdk_ref_exists=true
    sdk_ref_sha256=$(sha256_file "$SDK_REF_MANIFEST")
    sdk_ref_schema=$(manifest_value schema "$SDK_REF_MANIFEST")
    sdk_ref_split=$(manifest_value split_interfaces "$SDK_REF_MANIFEST")
    sdk_ref_portmaps=$(manifest_value generated_config_portmap_count "$SDK_REF_MANIFEST")
    sdk_ref_config_sha=$(manifest_value generated_config_bcm_sha256 "$SDK_REF_MANIFEST")
    sdk_ref_phy_sha=$(manifest_value generated_phy_soc_sha256 "$SDK_REF_MANIFEST")
    sdk_ref_fixup_sha=$(manifest_value generated_fixup_soc_sha256 "$SDK_REF_MANIFEST")
    sdk_ref_globals=$(manifest_value generated_has_l2xmsg_chunks "$SDK_REF_MANIFEST")
    sdk_ref_phy84848=$(manifest_value generated_has_phy_84848 "$SDK_REF_MANIFEST")
    sdk_ref_unsplit=$(manifest_value generated_has_unsplit_fxe52 "$SDK_REF_MANIFEST")
fi

eth=eth1
eth_dir="/sys/class/net/$eth"
eth_present=false
[ -d "$eth_dir" ] && eth_present=true
eth_address=$(read_first "$eth_dir/address")
eth_operstate=$(read_first "$eth_dir/operstate")
eth_carrier=$(read_first "$eth_dir/carrier")
eth_speed=$(read_first "$eth_dir/speed")
eth_duplex=$(read_first "$eth_dir/duplex")

bcm_present=false
bcm_slot=
bcm_driver=
for dev in /sys/bus/pci/devices/*; do
    [ -d "$dev" ] || continue
    vendor=$(read_first "$dev/vendor")
    device=$(read_first "$dev/device")
    if [ "$vendor" = "0x14e4" ] && [ "$device" = "0xb846" ]; then
        bcm_present=true
        bcm_slot=${dev##*/}
        if [ -L "$dev/driver" ]; then
            bcm_driver=$(basename "$(readlink "$dev/driver")")
        fi
        break
    fi
done

switchd_pids=$(pidof switchd 2>/dev/null || true)
switchd_running=false
[ -n "$switchd_pids" ] && switchd_running=true

capture_latest=$(latest_dir "$CAPTURE_BASE" '[0-9]*T*Z*')
capture_archive=$(latest_file "$CAPTURE_BASE" '[0-9]*T*Z*.tar.gz')
capture_summary=
capture_summary_present=false
if [ -n "$capture_latest" ]; then
    capture_summary="$capture_latest/capture-summary.txt"
    [ -f "$capture_summary" ] && capture_summary_present=true
fi

validate_latest=$(latest_dir "$VALIDATE_BASE" 'validate-*')
validate_bundle=$(latest_file "$VALIDATE_BASE" 'validate-*.tar.gz')
validate_log=
validate_log_exists=false
validate_pass_count=0
validate_warn_count=0
validate_fail_count=0
validate_complete=
validate_evidence_dir=
validate_bundle_line=
if [ -n "$validate_latest" ]; then
    validate_log="$validate_latest/validate.log"
    [ -f "$validate_log" ] && validate_log_exists=true
    validate_pass_count=$(grep_count "$validate_log" '^PASS:')
    validate_warn_count=$(grep_count "$validate_log" '^WARN:')
    validate_fail_count=$(grep_count "$validate_log" '^FAIL:')
    validate_complete=$(sed_last_value "$validate_log" 's/^Redstone stage-1 validation complete: //p')
    validate_evidence_dir=$(sed_last_value "$validate_log" 's/^Evidence directory: //p')
    validate_bundle_line=$(sed_last_value "$validate_log" 's/^Validation bundle: //p')
    [ -n "$validate_bundle" ] || validate_bundle=$validate_bundle_line
fi

bench_latest=$(latest_dir "$BENCH_BASE" 'bench-run-*')
bench_log=
bench_capture_only=
bench_validate_exit=
bench_validation_bundle=
bench_validation_evidence_dir=
bench_bde_smoke_exit=
if [ -n "$bench_latest" ]; then
    bench_log="$bench_latest/bench-run.log"
    bench_capture_only=$(kv_last_value "$bench_log" capture_only)
    bench_validate_exit=$(kv_last_value "$bench_log" validate_exit)
    bench_validation_bundle=$(kv_last_value "$bench_log" validation_bundle)
    bench_validation_evidence_dir=$(kv_last_value "$bench_log" validation_evidence_dir)
    bench_bde_smoke_exit=$(kv_last_value "$bench_log" bde_smoke_exit)
fi

probe_file=
if [ -n "$validate_latest" ]; then
    probe_file=$(first_existing_file "$validate_latest/openbcm_init_probe_dry_run.txt")
fi
if [ -z "$probe_file" ] && [ -n "$capture_latest" ]; then
    probe_file=$(first_existing_file "$capture_latest/openbcm_init_probe.txt")
fi
probe_present=false
probe_exit=
probe_unavailable=false
if [ -n "$probe_file" ]; then
    probe_present=true
    probe_exit=$(kv_last_value "$probe_file" exit)
    if grep -Eiq 'unavailable|not packaged|not found' "$probe_file" 2>/dev/null; then
        probe_unavailable=true
    fi
fi

web_action_latest=$(latest_dir "$ACTION_BASE" '*')
web_action_result=
web_action_action=
web_action_status=
web_action_exit=
web_action_started_at=
web_action_finished_at=
web_action_run_dir=
web_action_log=
web_action_evidence_dir=
web_action_message=
if [ -n "$web_action_latest" ]; then
    web_action_result="$web_action_latest/result.env"
    web_action_action=$(kv_last_value "$web_action_result" action)
    web_action_status=$(kv_last_value "$web_action_result" status)
    web_action_exit=$(kv_last_value "$web_action_result" exit)
    web_action_started_at=$(kv_last_value "$web_action_result" started_at)
    web_action_finished_at=$(kv_last_value "$web_action_result" finished_at)
    web_action_run_dir=$(kv_last_value "$web_action_result" run_dir)
    web_action_log=$(kv_last_value "$web_action_result" log)
    web_action_evidence_dir=$(kv_last_value "$web_action_result" evidence_dir)
    web_action_message=$(kv_last_value "$web_action_result" message)
fi

cat <<EOF
{
  "schema": "redstone-mgmt-status.v1",
  "generated_at": $(json_str "$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date 2>/dev/null || true)"),
  "hostname": $(json_str "$(hostname 2>/dev/null || true)"),
  "board": $(json_str "$board"),
  "selected_config": {
    "path": $(json_str "$selected_config"),
    "exists": $config_exists,
    "sha256": $(json_str "$config_sha256"),
    "portmap_count": $portmap_count,
    "split_mode": $(json_str "$split_mode")
  },
  "original_sdk_reference": {
    "manifest_path": $(json_str "$SDK_REF_MANIFEST"),
    "exists": $sdk_ref_exists,
    "sha256": $(json_str "$sdk_ref_sha256"),
    "schema": $(json_str "$sdk_ref_schema"),
    "split_interfaces": $(json_str "$sdk_ref_split"),
    "generated_portmap_count": $(json_str "$sdk_ref_portmaps"),
    "generated_config_sha256": $(json_str "$sdk_ref_config_sha"),
    "generated_phy_sha256": $(json_str "$sdk_ref_phy_sha"),
    "generated_fixup_sha256": $(json_str "$sdk_ref_fixup_sha"),
    "has_original_global_tuning": $(json_str "$sdk_ref_globals"),
    "has_phy_84848": $(json_str "$sdk_ref_phy84848"),
    "fxe52_unsplit": $(json_str "$sdk_ref_unsplit")
  },
  "management_eth1": {
    "present": $eth_present,
    "address": $(json_str "$eth_address"),
    "operstate": $(json_str "$eth_operstate"),
    "carrier": $(json_str "$eth_carrier"),
    "speed": $(json_str "$eth_speed"),
    "duplex": $(json_str "$eth_duplex")
  },
  "bcm56846": {
    "pci_present": $bcm_present,
    "slot": $(json_str "$bcm_slot"),
    "driver": $(json_str "$bcm_driver")
  },
  "bde": {
    "kernel_node": $(bool_file /dev/linux-kernel-bde),
    "user_node": $(bool_file /dev/linux-user-bde),
    "kernel_module": $(module_loaded linux-kernel-bde linux_kernel_bde),
    "user_module": $(module_loaded linux-user-bde linux_user_bde)
  },
  "switchd": {
    "running": $switchd_running,
    "pids": $(json_str "$switchd_pids")
  },
  "tools": {
    "redstone_stage1_capture": $(bool_cmd redstone-stage1-capture),
    "redstone_stage1_validate": $(bool_cmd redstone-stage1-validate),
    "redstone_stage1_bench_run": $(bool_cmd redstone-stage1-bench-run),
    "redstone_openbcm_bde_smoke": $(bool_cmd redstone-openbcm-bde-smoke.sh),
    "redstone_openbcm_init_probe": $(bool_cmd redstone-openbcm-init-probe),
    "busybox_httpd": $(bool_httpd)
  },
  "web_action": {
    "base": $(json_str "$ACTION_BASE"),
    "latest_dir": $(json_str "$web_action_latest"),
    "result": $(json_str "$web_action_result"),
    "action": $(json_str "$web_action_action"),
    "status": $(json_str "$web_action_status"),
    "exit": $(json_str "$web_action_exit"),
    "started_at": $(json_str "$web_action_started_at"),
    "finished_at": $(json_str "$web_action_finished_at"),
    "run_dir": $(json_str "$web_action_run_dir"),
    "log": $(json_str "$web_action_log"),
    "evidence_dir": $(json_str "$web_action_evidence_dir"),
    "message": $(json_str "$web_action_message")
  },
  "evidence": {
    "capture_base": $(json_str "$CAPTURE_BASE"),
    "latest_capture_dir": $(json_str "$capture_latest"),
    "latest_capture_archive": $(json_str "$capture_archive"),
    "latest_capture_summary": {
      "path": $(json_str "$capture_summary"),
      "exists": $capture_summary_present
    },
    "validate_base": $(json_str "$VALIDATE_BASE"),
    "latest_validate_dir": $(json_str "$validate_latest"),
    "latest_validate_bundle": $(json_str "$validate_bundle"),
    "validation_summary": {
      "log": $(json_str "$validate_log"),
      "log_exists": $validate_log_exists,
      "pass_count": $validate_pass_count,
      "warn_count": $validate_warn_count,
      "fail_count": $validate_fail_count,
      "complete": $(json_str "$validate_complete"),
      "evidence_dir": $(json_str "$validate_evidence_dir")
    },
    "bench_base": $(json_str "$BENCH_BASE"),
    "latest_bench_dir": $(json_str "$bench_latest"),
    "bench_summary": {
      "log": $(json_str "$bench_log"),
      "capture_only": $(json_str "$bench_capture_only"),
      "validate_exit": $(json_str "$bench_validate_exit"),
      "validation_bundle": $(json_str "$bench_validation_bundle"),
      "validation_evidence_dir": $(json_str "$bench_validation_evidence_dir"),
      "bde_smoke_exit": $(json_str "$bench_bde_smoke_exit")
    },
    "init_probe_dry_run": {
      "path": $(json_str "$probe_file"),
      "exists": $probe_present,
      "exit": $(json_str "$probe_exit"),
      "unavailable": $probe_unavailable
    }
  }
}
EOF
