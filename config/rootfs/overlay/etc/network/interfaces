# /etc/network/interfaces - EdgeNOS management interface config
#
# Loopback is brought up by /etc/init.d/S39loopback. Redstone stage-1 builds
# replace this file in post-build with a manual-only bring-up profile so eth0
# and eth2 do not interfere with eth1 SGMII/TBI testing.

# Management Ethernet (P2020 eTSEC)
# Kernel 5.10+ names it end0, older kernels use eth0
auto eth0
iface eth0 inet dhcp

auto end0
iface end0 inet dhcp
