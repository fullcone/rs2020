# /etc/network/interfaces - EdgeNOS management interface config
#
# NOTE: loopback is brought up by /etc/init.d/S39loopback because
# Buildroot's busybox config does not include CONFIG_FEATURE_IFUPDOWN_IPV4,
# so ifup does not understand the "loopback" method. Listing it here would
# fail with `ifup: unknown method "loopback"`.

# Management Ethernet (P2020 eTSEC)
# Kernel 5.10+ names it end0, older kernels use eth0
auto eth0
iface eth0 inet dhcp

auto end0
iface end0 inet dhcp
