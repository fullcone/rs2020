# EdgeNOS busybox config fragment
# Enables features that are excluded from buildroot's default busybox config
# but are needed by the EdgeNOS rootfs init scripts.

# ifupdown methods (loopback, static, dhcp). Without this, /etc/network/interfaces
# entries fail with "ifup: unknown method ...".
CONFIG_FEATURE_IFUPDOWN_IPV4=y
CONFIG_FEATURE_IFUPDOWN_IPV6=y
CONFIG_FEATURE_IFUPDOWN_MAPPING=y
CONFIG_FEATURE_IFUPDOWN_EXTERNAL_DHCP=y

# udhcpc (DHCP client) - needed for "iface eth0 inet dhcp"
CONFIG_UDHCPC=y
CONFIG_FEATURE_UDHCPC_ARPING=y
CONFIG_UDHCPC_DEFAULT_SCRIPT="/usr/share/udhcpc/default.script"

# ifconfig - keep classic tool available for our S39loopback fallback
CONFIG_IFCONFIG=y
CONFIG_FEATURE_IFCONFIG_STATUS=y
